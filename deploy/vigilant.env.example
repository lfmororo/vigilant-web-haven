# Configuração da implantação do vigilant-web-haven na VPS.
# Copie para deploy/vigilant.env, preencha e rode: sudo bash deploy/install.sh

# Endereços (os dois precisam apontar para o IP da VPS no DNS, registro A)
PAINEL_DOMAIN=painel.mororo.tech
API_DOMAIN=api.mororo.tech
# E-mail para o certificado SSL (Let's Encrypt)
LETSENCRYPT_EMAIL=

# Pasta da instalação
INSTALL_DIR=/opt/vigilant

# Portas locais (só 127.0.0.1; o proxy reverso publica o que for preciso).
# Escolhidas para não colidir com Evolution API / RustDesk / Postgres já existentes.
API_LOCAL_PORT=54321
DB_LOCAL_PORT=54322
POOLER_LOCAL_PORT=54329

# IA (Google AI Studio → Get API key). AI_MODEL é opcional: força um modelo para todas as chamadas.
GEMINI_API_KEY=
AI_MODEL=

# Opcionais (mesmos segredos que estão na Lovable Cloud > Secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
MONITOR_REQUIRE_TOKEN=true

# E-mail do login (recuperação de senha). Sem SMTP, deixe ENABLE_EMAIL_AUTOCONFIRM=true.
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Mororo.Tech

# Projeto antigo na Lovable Cloud (usado para trocar endereços e baixar os arquivos)
OLD_SUPABASE_URL=https://egbusmegupjfxqswdlxq.supabase.co
