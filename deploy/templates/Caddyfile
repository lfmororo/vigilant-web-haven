# vigilant-web-haven — gerado por deploy/install.sh
__PAINEL_DOMAIN__ {
    root * __INSTALL_DIR__/painel
    encode gzip
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
}

__API_DOMAIN__ {
    @api path_regexp ^/(auth|rest|storage|functions|realtime|graphql)/v1/
    handle @api {
        reverse_proxy 127.0.0.1:__API_LOCAL_PORT__
    }
    handle {
        respond 404
    }
}
